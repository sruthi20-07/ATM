# -----------------------------
# Server Settings
# -----------------------------
server.port=8056
spring.application.name=ATM-Project

# -----------------------------
# Database Configuration
# Uses env variables if available, otherwise local defaults
# -----------------------------
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/atm_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}

spring.datasource.username=${DB_USERNAME:root}

spring.datasource.password=${DB_PASSWORD:root}

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# -----------------------------
# Hibernate / JPA Settings
# -----------------------------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# -----------------------------
# SendGrid API Key
# -----------------------------
sendgrid.api.key=${SENDGRID_API_KEY:}

# -----------------------------
# Custom Email Info
# -----------------------------
email.from.address=${EMAIL_FROM:dummy@example.com}
email.from.name=SBI ATM Service

# -----------------------------
# Spring Security
# -----------------------------
spring.security.user.name=${SECURITY_USERNAME:user}
spring.security.user.password=${SECURITY_PASSWORD:password}
spring.security.user.roles=USER

# -----------------------------
# Logging
# -----------------------------
logging.level.org.springframework=INFO
logging.level.com.atm=DEBUG
